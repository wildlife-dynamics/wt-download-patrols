            }
          }
        }
      },
      "generate_maps": {
        "value": {
          "ui:help": "Not recommended for large datasets to improve performance."
        }
      }
    },
    "Group Data": {
      "ui:order": [
        "groupers",
        "traj_rename_grouper_columns"
      ]
    },
    "Refine Patrol Data": {
      "ui:order": [
        "customize_columns_traj",

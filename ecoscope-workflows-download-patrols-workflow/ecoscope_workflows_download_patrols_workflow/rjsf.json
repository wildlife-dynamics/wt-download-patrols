        "ui:order": [
          "drop_columns",
          "duplicate_strategy"
        ]
      }
    },
    "Patrol Track & Event Download File Format": {
      "download_params": {
        "ui:order": [
          "track_filetypes",
          "event_filetypes",
          "track_filename_prefix",
          "event_filename_prefix"
        ]
      }
    },
    "ui:order": [
      "workflow_details",
      "er_client_name",
      "time_range",
      "Patrol and Event Types",
      "Filter Data",
      "Group Data",
      "Refine Patrol Data",
      "Patrol Track & Event Download File Format",
      "Generate Maps"
    ]
  },
  "additionalProperties": false
}
